<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMS Revenue Calculator | Mobile Text Alerts</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet">
<style>
  :root {
    --teal: #1a7a5a;
    --teal-dark: #145e46;
    --teal-deeper: #0f4a37;
    --teal-light: #edf5f0;
    --teal-lighter: #f4f9f6;
    --sage: #d4e4da;
    --coral: #e8604c;
    --coral-hover: #d4503e;
    --bg: #ffffff;
    --text: #1a3c34;
    --text-sec: #4a6960;
    --text-dim: #8a9f98;
    --border: #d6e2dc;
    --inp-bg: #f4f7f5;
    --inp-focus: #eaf0ec;
    --err: #d93025;
    --shadow: 0 2px 8px rgba(26,60,52,0.06);
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--teal-lighter);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .calc-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .calc-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .calc-header .eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 12px;
  }

  .calc-header h1 {
    font-size: 36px;
    font-weight: 700;
    color: var(--teal-dark);
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .calc-header .subtitle {
    font-size: 16px;
    color: var(--text-sec);
    max-width: 520px;
    margin: 0 auto;
  }

  .calc-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  /* ===== LEFT PANEL ===== */
  .panel-input {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    box-shadow: var(--shadow);
  }

  .panel-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--teal);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .field { margin-bottom: 16px; }

  .field > label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-sec);
    margin-bottom: 4px;
  }

  .field > label .req { color: var(--coral); margin-left: 2px; }

  .field input, .field select {
    width: 100%;
    height: 42px;
    padding: 0 12px;
    background: var(--inp-bg);
    border: 1.5px solid transparent;
    border-radius: 8px;
    color: var(--text);
    font-family: inherit;
    font-size: 14px;
    transition: all 0.15s;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .field select {
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%238a9f98' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    padding-right: 32px;
    cursor: pointer;
  }

  .field input:focus, .field select:focus {
    border-color: var(--teal);
    background: var(--inp-focus);
  }

  .field input::placeholder { color: var(--text-dim); }

  .inp-w { position: relative; }
  .inp-w .pre {
    position:absolute; left:12px; top:50%; transform:translateY(-50%);
    color:var(--text-dim); font-size:14px; pointer-events:none;
  }
  .inp-w .suf {
    position:absolute; right:12px; top:50%; transform:translateY(-50%);
    color:var(--text-dim); font-size:11px; font-weight:600; pointer-events:none;
  }
  .inp-w input.pl { padding-left:28px; }
  .inp-w input.pr { padding-right:34px; }

  .row2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }

  /* Channel selector as pills */
  .channel-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .channel-pills label {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    background: var(--inp-bg);
    border: 1.5px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    color: var(--text-sec);
    transition: all 0.15s;
    user-select: none;
  }

  .channel-pills label:hover { background: var(--inp-focus); }

  .channel-pills input { display: none; }

  .channel-pills label.on {
    border-color: var(--teal);
    background: var(--teal-light);
    color: var(--teal);
    font-weight: 600;
  }

  /* Conditional fields */
  .cond {
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.2s ease;
  }
  .cond.show { max-height: 300px; opacity: 1; }
  .cond.hide { max-height: 0; opacity: 0; pointer-events: none; }

  .btn-calc {
    width: 100%;
    height: 46px;
    margin-top: 8px;
    background: var(--coral);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .btn-calc:hover { background: var(--coral-hover); }

  .err-msg { color:var(--err); font-size:11px; margin-top:2px; display:none; }
  .field.err .err-msg { display:block; }
  .field.err input, .field.err select { border-color:var(--err); }

  /* ===== RIGHT PANEL ===== */
  .panel-results {
    position: sticky;
    top: 24px;
  }

  .results-placeholder {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 48px 32px;
    text-align: center;
    box-shadow: var(--shadow);
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .ph-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--teal-light);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
  }

  .ph-icon svg { width:28px; height:28px; }

  .results-placeholder h3 {
    font-size: 18px; font-weight: 600;
    color: var(--teal-dark); margin-bottom: 8px;
  }

  .results-placeholder p {
    font-size: 14px; color: var(--text-dim); max-width: 260px;
  }

  .results-live { display: none; }
  .results-live.on {
    display: block;
    animation: slideIn 0.5s ease-out;
  }

  @keyframes slideIn {
    from { opacity:0; transform:translateY(12px); }
    to { opacity:1; transform:translateY(0); }
  }

  /* Hero card */
  .hero-card {
    background: var(--teal-dark);
    border-radius: 16px;
    padding: 32px;
    text-align: center;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }

  .hero-card::before {
    content:''; position:absolute; top:-40px; right:-40px;
    width:120px; height:120px; border-radius:50%;
    background:rgba(255,255,255,0.05);
  }

  .hero-card::after {
    content:''; position:absolute; bottom:-30px; left:-30px;
    width:80px; height:80px; border-radius:50%;
    background:rgba(255,255,255,0.04);
  }

  .hero-card .h-label {
    font-size:11px; font-weight:600; color:var(--sage);
    text-transform:uppercase; letter-spacing:1.5px;
    margin-bottom:8px; position:relative;
  }

  .hero-card .h-value {
    font-size:52px; font-weight:700; color:#fff;
    line-height:1; letter-spacing:-2px; position:relative;
  }

  .hero-card .h-sub {
    font-size:13px; color:rgba(255,255,255,0.55);
    margin-top:6px; position:relative;
  }

  .stat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }

  .stat-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    box-shadow: var(--shadow);
  }

  .stat-card .s-label {
    font-size:10px; font-weight:600; color:var(--text-dim);
    text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;
  }

  .stat-card .s-value {
    font-size:22px; font-weight:700; color:var(--text);
    letter-spacing:-0.5px;
  }

  .stat-card .s-value.teal { color:var(--teal); }

  /* Comparison bars */
  .compare-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }

  .compare-card .cc-title {
    font-size:11px; font-weight:600; color:var(--text-dim);
    text-transform:uppercase; letter-spacing:0.5px; margin-bottom:14px;
  }

  .bar-group { margin-bottom:14px; }
  .bar-group:last-child { margin-bottom:0; }

  .bar-section-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }

  .bar-header {
    display:flex; justify-content:space-between; align-items:center;
    margin-bottom:4px;
  }

  .bar-header .bar-label { font-size:11px; color:var(--text-dim); }
  .bar-header .bar-val { font-size:13px; font-weight:700; color:var(--text); }
  .bar-header .bar-val.teal { color:var(--teal); }

  .bar-track {
    width:100%; height:8px;
    background:var(--teal-light);
    border-radius:4px; overflow:hidden;
    margin-bottom: 6px;
  }

  .bar-fill {
    height:100%; border-radius:4px;
    transition:width 0.8s ease-out; width:0;
  }

  .bar-fill.current { background:var(--sage); }
  .bar-fill.sms { background:var(--teal); }

  /* Assumptions */
  .assumptions-card {
    background: var(--teal-light);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .assumptions-card h4 {
    font-size:11px; font-weight:600; color:var(--teal);
    text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;
  }

  .assumptions-card p {
    font-size:12px; color:var(--text-sec); line-height:1.7;
  }

  /* CTA */
  .cta-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    box-shadow: var(--shadow);
  }

  .cta-card h3 {
    font-size:17px; font-weight:700; color:var(--teal-dark); margin-bottom:4px;
  }

  .cta-card p {
    font-size:13px; color:var(--text-sec); margin-bottom:14px;
  }

  .cta-btns { display:flex; justify-content:center; gap:8px; flex-wrap:wrap; }

  .cta-btn {
    display:inline-flex; align-items:center; justify-content:center;
    height:40px; padding:0 20px; border-radius:8px;
    font-family:inherit; font-size:12px; font-weight:600;
    cursor:pointer; text-decoration:none; transition:all 0.15s;
    border:none; text-transform:uppercase; letter-spacing:0.5px;
  }

  .cta-btn.primary { background:var(--coral); color:#fff; }
  .cta-btn.primary:hover { background:var(--coral-hover); }
  .cta-btn.outline { background:transparent; color:var(--teal); border:1.5px solid var(--teal); }
  .cta-btn.outline:hover { background:var(--teal-light); }

  .recalc-link {
    display:inline-block; margin-top:12px;
    font-size:12px; color:var(--text-dim);
    text-decoration:underline; cursor:pointer;
    transition:color 0.15s;
  }
  .recalc-link:hover { color:var(--teal); }

  /* ===== MOBILE ===== */
  @media (max-width: 768px) {
    .calc-body { grid-template-columns: 1fr; }
    .panel-results { position: static; }
    .calc-header h1 { font-size: 28px; }
    .hero-card .h-value { font-size: 40px; }
  }

  @media (max-width: 480px) {
    .calc-container { padding: 24px 16px 60px; }
    .panel-input { padding: 24px; }
    .row2 { grid-template-columns: 1fr; }
    .stat-row { grid-template-columns: 1fr; }
    .cta-btns { flex-direction: column; }
    .cta-btn { width: 100%; }
    .channel-pills { gap: 4px; }
    .channel-pills label { padding: 6px 12px; font-size: 12px; }
  }
</style>
</head>
<body>

<div class="calc-container">

  <div class="calc-header">
    <div class="eyebrow">SMS Revenue Calculator</div>
    <h1>See What SMS Could Do for Your Revenue</h1>
    <p class="subtitle">Enter your current marketing numbers and instantly see your projected SMS revenue.</p>
  </div>

  <div class="calc-body">

    <!-- LEFT: INPUTS -->
    <div class="panel-input">
      <div class="panel-title">Your Details</div>

      <div class="field">
        <label>Primary marketing channel <span class="req">*</span></label>
        <div class="channel-pills" id="channelPills">
          <label onclick="pickChannel('email',this)"><input type="radio" name="channel" value="email"> Email</label>
          <label onclick="pickChannel('social',this)"><input type="radio" name="channel" value="social"> Social</label>
          <label onclick="pickChannel('directmail',this)"><input type="radio" name="channel" value="directmail"> Direct Mail</label>
          <label onclick="pickChannel('none',this)"><input type="radio" name="channel" value="none"> None / Other</label>
        </div>
      </div>

      <div class="field">
        <label>Subscriber / contact list size <span class="req">*</span></label>
        <input type="text" id="listSize" placeholder="e.g. 5,000" inputmode="numeric">
        <div class="err-msg">Minimum 100 contacts</div>
      </div>

      <!-- Email-only fields -->
      <div class="cond hide" id="emailFields">
        <div class="row2">
          <div class="field">
            <label>Current email open rate <span class="req">*</span></label>
            <div class="inp-w">
              <input type="text" id="openRate" placeholder="e.g. 25" class="pr" inputmode="decimal">
              <span class="suf">%</span>
            </div>
            <div class="err-msg">1 - 100%</div>
          </div>
          <div class="field">
            <label>Email conversion rate <span class="req">*</span></label>
            <div class="inp-w">
              <input type="text" id="cvr" placeholder="e.g. 2" class="pr" inputmode="decimal">
              <span class="suf">%</span>
            </div>
            <div class="err-msg">0.1 - 50%</div>
          </div>
        </div>
        <div class="field">
          <label>Email campaigns / month <span class="req">*</span></label>
          <input type="text" id="campaigns" placeholder="e.g. 4" inputmode="numeric">
          <div class="err-msg">1 - 30</div>
        </div>
      </div>

      <div class="field">
        <label>Average order / deal value <span class="req">*</span></label>
        <div class="inp-w">
          <span class="pre">$</span>
          <input type="text" id="avgRev" placeholder="e.g. 75" class="pl" inputmode="decimal">
        </div>
        <div class="err-msg">Minimum $1</div>
      </div>

      <button class="btn-calc" onclick="onCalc()">Calculate My SMS Revenue</button>
    </div>

    <!-- RIGHT: RESULTS -->
    <div class="panel-results">

      <div class="results-placeholder" id="placeholder">
        <div class="ph-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#1a7a5a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
        </div>
        <h3>Your Results Will Appear Here</h3>
        <p>Fill in your details on the left and hit calculate to see your projected SMS revenue.</p>
      </div>

      <div class="results-live" id="resultsLive">

        <div class="hero-card">
          <div class="h-label">Projected Annual SMS Revenue</div>
          <div class="h-value" id="heroVal">$0</div>
          <div class="h-sub">Based on your inputs</div>
        </div>

        <div class="stat-row" id="statRow1">
          <div class="stat-card">
            <div class="s-label">Monthly SMS Revenue</div>
            <div class="s-value teal" id="sMoRev">$0</div>
          </div>
          <div class="stat-card" id="statComp">
            <div class="s-label" id="sCompLabel">Current Monthly Revenue</div>
            <div class="s-value" id="sCompVal">$0</div>
          </div>
        </div>

        <div class="stat-row">
          <div class="stat-card">
            <div class="s-label">Revenue Per Subscriber</div>
            <div class="s-value" id="sRPS">$0</div>
          </div>
          <div class="stat-card">
            <div class="s-label">SMS Conversions / mo</div>
            <div class="s-value teal" id="sConv">0</div>
          </div>
        </div>

        <div class="compare-card" id="compareCard" style="display:none">
          <div class="cc-title">Email vs SMS</div>

          <div class="bar-group">
            <div class="bar-section-label">Open Rate</div>
            <div class="bar-header">
              <span class="bar-label">Email</span>
              <span class="bar-val" id="bOpenCur">25%</span>
            </div>
            <div class="bar-track"><div class="bar-fill current" id="barOpenCur"></div></div>
            <div class="bar-header" style="margin-top:6px">
              <span class="bar-label" style="color:var(--teal)">SMS</span>
              <span class="bar-val teal">98%</span>
            </div>
            <div class="bar-track"><div class="bar-fill sms" id="barOpenSms"></div></div>
          </div>

          <div class="bar-group">
            <div class="bar-section-label">Conversion Rate</div>
            <div class="bar-header">
              <span class="bar-label">Email</span>
              <span class="bar-val" id="bCvrCur">2%</span>
            </div>
            <div class="bar-track"><div class="bar-fill current" id="barCvrCur"></div></div>
            <div class="bar-header" style="margin-top:6px">
              <span class="bar-label" style="color:var(--teal)">SMS (2.5x)</span>
              <span class="bar-val teal" id="bCvrSms">5%</span>
            </div>
            <div class="bar-track"><div class="bar-fill sms" id="barCvrSms"></div></div>
          </div>
        </div>

        <div class="assumptions-card">
          <h4>How We Calculated This</h4>
          <p id="assumpText"></p>
        </div>

        <div class="cta-card">
          <h3>Ready to Generate This Revenue?</h3>
          <p>Free 14-day trial. No credit card required.</p>
          <div class="cta-btns">
            <a href="https://mobile-text-alerts.com/signup" class="cta-btn primary">Start Free Trial</a>
            <a href="https://mobile-text-alerts.com/contact" class="cta-btn outline">Talk to Sales</a>
          </div>
          <span class="recalc-link" onclick="onReset()">Recalculate with different numbers</span>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var selectedChannel = null;

  window.pickChannel = function(val, el) {
    document.querySelectorAll('#channelPills label').forEach(function(l) { l.classList.remove('on'); });
    el.classList.add('on');
    el.querySelector('input').checked = true;
    selectedChannel = val;

    var ef = document.getElementById('emailFields');
    if (val === 'email') {
      ef.classList.remove('hide');
      ef.classList.add('show');
    } else {
      ef.classList.remove('show');
      ef.classList.add('hide');
    }
  };

  function pn(v) { return parseFloat(v.replace(/[^0-9.]/g,'')); }
  function fc(n) { return n>=1e6?'$'+(n/1e6).toFixed(1)+'M':'$'+Math.round(n).toLocaleString('en-US'); }
  function fc2(n) { return '$'+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }

  function vf(id,min,max) {
    var el=document.getElementById(id),g=el.closest('.field'),v=pn(el.value);
    if(isNaN(v)||v<min||(max!==undefined&&v>max)){g.classList.add('err');return null;}
    g.classList.remove('err');return v;
  }

  function animVal(el,target,prefix) {
    prefix=prefix||'';
    var dur=600,start=null;
    function step(ts) {
      if(!start) start=ts;
      var p=Math.min((ts-start)/dur,1);
      p=1-Math.pow(1-p,3);
      el.textContent=prefix+Math.round(target*p).toLocaleString('en-US');
      if(p<1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  window.onCalc = function() {
    var ok=true;

    // Channel required
    if(!selectedChannel) {
      // Highlight the channel field
      return;
    }

    if(vf('listSize',100)===null) ok=false;
    if(vf('avgRev',1)===null) ok=false;

    if(selectedChannel==='email') {
      if(vf('openRate',1,100)===null) ok=false;
      if(vf('cvr',0.1,50)===null) ok=false;
      if(vf('campaigns',1,30)===null) ok=false;
    }

    if(!ok) return;
    calc();
  };

  window.onReset = function() {
    document.getElementById('resultsLive').classList.remove('on');
    document.getElementById('placeholder').style.display='flex';
    document.querySelectorAll('.bar-fill').forEach(function(b){b.style.width='0';});
  };

  function calc() {
    var list=pn(document.getElementById('listSize').value);
    var avg=pn(document.getElementById('avgRev').value);

    document.getElementById('placeholder').style.display='none';
    document.getElementById('resultsLive').classList.add('on');

    if(selectedChannel==='email') {
      var or=pn(document.getElementById('openRate').value)/100;
      var cr=pn(document.getElementById('cvr').value)/100;
      var cp=pn(document.getElementById('campaigns').value);

      // Current email revenue
      var curMo=list*or*cr*avg*cp;

      // SMS projected
      var smsCr=cr*2.5;
      var smsConvMo=list*0.98*smsCr*cp;
      var smsMo=list*0.98*smsCr*avg*cp;
      var smsYr=smsMo*12;
      var rps=smsMo/list;

      animVal(document.getElementById('heroVal'),Math.round(smsYr),'$');
      animVal(document.getElementById('sMoRev'),Math.round(smsMo),'$');

      document.getElementById('sCompLabel').textContent='Current Monthly Revenue from Email';
      animVal(document.getElementById('sCompVal'),Math.round(curMo),'$');
      document.getElementById('statComp').style.display='block';

      document.getElementById('sRPS').textContent=fc2(rps);
      animVal(document.getElementById('sConv'),Math.round(smsConvMo));

      // Comparison bars
      document.getElementById('compareCard').style.display='block';
      document.getElementById('bOpenCur').textContent=(or*100).toFixed(0)+'%';
      document.getElementById('bCvrCur').textContent=(cr*100).toFixed(1)+'%';
      document.getElementById('bCvrSms').textContent=(smsCr*100).toFixed(1)+'%';

      setTimeout(function() {
        document.getElementById('barOpenCur').style.width=(or*100)+'%';
        document.getElementById('barOpenSms').style.width='98%';
        var maxCvr=Math.max(smsCr*100,10);
        document.getElementById('barCvrCur').style.width=((cr*100/maxCvr)*100)+'%';
        document.getElementById('barCvrSms').style.width=((smsCr*100/maxCvr)*100)+'%';
      },100);

      document.getElementById('assumpText').textContent=
        'These projections use a 98% SMS open rate (Gartner, Bloomreach) and a 2.5x multiplier on your '+
        (cr*100).toFixed(1)+'% email conversion rate, giving a projected '+
        (smsCr*100).toFixed(1)+'% SMS conversion rate. List size: '+
        list.toLocaleString()+' contacts. '+cp+' campaigns/month. Revenue figures are estimates based on industry data.';

    } else {
      // Non-email path: Social, Direct Mail, None
      // Use conservative defaults
      var defCvr=0.02;
      var defCamp=4;
      var smsConvMo=list*0.98*defCvr*defCamp;
      var smsMo=list*0.98*defCvr*avg*defCamp;
      var smsYr=smsMo*12;
      var rps=smsMo/list;

      animVal(document.getElementById('heroVal'),Math.round(smsYr),'$');
      animVal(document.getElementById('sMoRev'),Math.round(smsMo),'$');

      document.getElementById('sCompLabel').textContent='SMS Open Rate';
      document.getElementById('sCompVal').textContent='98%';
      document.getElementById('statComp').style.display='block';

      document.getElementById('sRPS').textContent=fc2(rps);
      animVal(document.getElementById('sConv'),Math.round(smsConvMo));

      // No comparison bars for non-email
      document.getElementById('compareCard').style.display='none';

      var channelName = selectedChannel === 'social' ? 'social media' :
                        selectedChannel === 'directmail' ? 'direct mail' : 'no existing channel';

      document.getElementById('assumpText').textContent=
        'Since your primary channel is '+channelName+
        ', we used conservative SMS benchmarks: 98% open rate (Gartner, Bloomreach), '+
        '2% conversion rate, and 4 campaigns/month applied to your list of '+
        list.toLocaleString()+' contacts. Revenue figures are estimates based on industry data.';
    }
  }

  // Format list size on blur
  document.getElementById('listSize').addEventListener('blur',function(){
    var v=pn(this.value);
    if(!isNaN(v)&&v>0) this.value=v.toLocaleString('en-US');
  });
})();
</script>
</body>
</html>
