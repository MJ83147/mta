  top: -40px;
  right: -40px;
  width: 140px;
  height: 140px;
  background: rgba(91,191,175,0.08);
  border-radius: 50%;
}
.stat-item { text-align: center; position: relative; z-index: 1; }
.stat-value {
  font-size: 32px;
  font-weight: 700;
  color: #fff;
}
.stat-label {
  font-size: 13px;
  color: rgba(255,255,255,0.45);
  margin-top: 4px;
}

/* Mockup label */
.mockup-label {
  position: fixed;
  bottom: 16px;
  right: 16px;
  background: #e8734a;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 6px;
  letter-spacing: 0.5px;
  z-index: 999;
  text-transform: uppercase;
}
</style>
