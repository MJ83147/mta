<title>SMS Compliance by Country | Mobile Text Alerts</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'DM Sans', sans-serif;
  background: #f5f2ec;
  color: #1a2e1a;
  overflow-x: hidden;
  min-height: 100vh;
}

/* Nav */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 40px;
  background: #1a3c2a;
  border-bottom: 3px solid #e8734a;
