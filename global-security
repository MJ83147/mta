  top: 0;
  z-index: 200;
}
.nav-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.3px;
  line-height: 1.15;
}
.nav-links { display: flex; gap: 28px; }
.nav-links a {
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: color 0.2s;
}
.nav-links a:hover { color: #fff; }
.nav-right { display: flex; align-items: center; gap: 16px; }
.nav-login {
  color: rgba(255,255,255,0.8);
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
}
.nav-cta {
  background: #e8734a;
  color: #fff;
  border: none;
  padding: 10px 20px;
  border-radius: 24px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s;
  letter-spacing: 0.3px;
  text-transform: uppercase;
}
.nav-cta:hover { background: #d4623b; }

/* Page content */
.page-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
}

/* Decorative floating shapes matching MTA's style */
.page-decor {
  position: absolute;
  pointer-events: none;
  z-index: 0;
}

/* Hero */
.hero {
  text-align: center;
  padding: 56px 0 20px;
  position: relative;
  z-index: 1;
}
.hero-eyebrow {
  display: inline-block;
  font-size: 16px;
  font-style: italic;
  color: #1a3c2a;
  margin-bottom: 8px;
}
.hero-eyebrow-line {
  display: block;
  width: 100%;
  height: 3px;
  background: #5bbfaf;
  margin-top: 4px;
  border-radius: 2px;
}
.hero h1 {
  font-size: 50px;
  font-weight: 700;
  letter-spacing: -1.5px;
  line-height: 1.08;
  margin-bottom: 16px;
  color: #1a2e1a;
}
.hero p {
  font-size: 17px;
  color: #5a6b5a;
  max-width: 560px;
  margin: 0 auto 28px;
  line-height: 1.6;
}
.hero-buttons {
  display: flex;
  justify-content: center;
  gap: 16px;
}
.btn-primary {
  background: #e8734a;
  color: #fff;
  border: none;
  padding: 14px 28px;
  border-radius: 28px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  transition: background 0.2s;
}
.btn-primary:hover { background: #d4623b; }
.btn-secondary {
  background: transparent;
  color: #1a3c2a;
  border: 1.5px solid #1a3c2a;
  padding: 14px 28px;
  border-radius: 28px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  transition: all 0.2s;
}
.btn-secondary:hover { background: #1a3c2a; color: #fff; }

/* Globe */
.globe-section {
  position: relative;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}
.globe-area {
  position: relative;
  height: 560px;
  overflow: visible;
}
#globe-container {
  width: 100%;
  height: 100%;
  cursor: grab;
}
#globe-container:active { cursor: grabbing; }

.globe-hint {
  text-align: center;
  font-size: 13px;
  color: #a0a898;
  padding: 4px 0 8px;
  font-style: italic;
}

/* Tooltip */
.tooltip {
  position: absolute;
  background: #fff;
  border: 1px solid #e2dfd8;
  border-radius: 16px;
  padding: 24px;
  min-width: 300px;
  max-width: 340px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
  transform: translateY(8px);
  z-index: 100;
  box-shadow: 0 12px 40px rgba(26,44,26,0.1);
  color: #1a2e1a;
}
.tooltip.active {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}
.tooltip-flag { font-size: 32px; margin-bottom: 8px; }
.tooltip-country {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 2px;
  letter-spacing: -0.3px;
}
.tooltip-regulation {
  font-size: 12px;
  font-weight: 700;
  color: #e8734a;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.tooltip-desc {
  font-size: 14px;
  color: #5a6b5a;
  line-height: 1.6;
  margin-bottom: 16px;
}
.tooltip-stats {
  display: flex;
  gap: 16px;
  margin-bottom: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid #eee9e0;
}
.tooltip-stat-item { flex: 1; }
.tooltip-stat-label {
  font-size: 11px;
  color: #a0a898;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 2px;
  font-weight: 600;
}
.tooltip-stat-value {
  font-size: 15px;
  font-weight: 700;
  color: #1a3c2a;
}
.tooltip-cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #1a3c2a;
  color: #fff;
  border: none;
  padding: 12px 20px;
  border-radius: 24px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s;
  width: 100%;
  justify-content: center;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}
.tooltip-cta:hover { background: #244d34; }
.tooltip-cta svg { width: 14px; height: 14px; }
.tooltip-close {
  position: absolute;
  top: 14px;
  right: 14px;
  background: #f5f2ec;
  border: none;
  color: #a0a898;
  cursor: pointer;
  font-size: 15px;
  line-height: 1;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.tooltip-close:hover { background: #eee9e0; color: #1a2e1a; }

/* Country pills */
.country-pills {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 24px 40px;
}
.country-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fff;
  border: 1.5px solid #ddd9d2;
  color: #5a6b5a;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 100px;
  cursor: pointer;
  transition: all 0.2s;
}
.country-pill:hover {
  border-color: #1a3c2a;
  color: #1a3c2a;
}
.country-pill.active {
  background: #1a3c2a;
  border-color: #1a3c2a;
  color: #fff;
}
.country-pill-flag { font-size: 16px; }

/* Stats bar */
.stats-bar {
  display: flex;
  justify-content: center;
  gap: 48px;
  padding: 40px 24px;
  background: #1a3c2a;
  border-radius: 16px;
