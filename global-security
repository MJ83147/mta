<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const countries = [
  { name:'United States', flag:'\u{1F1FA}\u{1F1F8}', lat:39.8, lon:-98.5, regulation:'TCPA + FCC', desc:'The Telephone Consumer Protection Act requires prior express written consent for marketing texts. Violations carry fines of $500\u2013$1,500 per message.', optin:'Express written', penalty:'$500\u2013$1.5K/msg' },
  { name:'United Kingdom', flag:'\u{1F1EC}\u{1F1E7}', lat:54.0, lon:-2.0, regulation:'PECR + ICO', desc:'Privacy and Electronic Communications Regulations require specific consent for direct marketing SMS. The ICO can issue substantial fines for non-compliance.', optin:'Soft or express', penalty:'Up to \u00A3500K' },
  { name:'Canada', flag:'\u{1F1E8}\u{1F1E6}', lat:56.1, lon:-106.3, regulation:'CASL', desc:"Canada's Anti-Spam Legislation is one of the strictest globally. Requires express or implied consent with clear identification and unsubscribe mechanisms.", optin:'Express or implied', penalty:'Up to $10M CAD' },
  { name:'Australia', flag:'\u{1F1E6}\u{1F1FA}', lat:-25.3, lon:133.8, regulation:'Spam Act + ACMA', desc:'The Spam Act 2003 requires consent, sender identification, and an unsubscribe facility in every commercial message. ACMA enforces with significant penalties.', optin:'Express or inferred', penalty:'Up to $2.2M AUD/day' },
  { name:'India', flag:'\u{1F1EE}\u{1F1F3}', lat:20.6, lon:79.0, regulation:'TRAI DND', desc:"TRAI's Do Not Disturb regulations use a national registry system. Senders must register message templates and transactional vs promotional categories.", optin:'Template-based', penalty:'License revocation' },
  { name:'Germany', flag:'\u{1F1E9}\u{1F1EA}', lat:51.2, lon:10.4, regulation:'GDPR + UWG', desc:'Under GDPR, SMS marketing requires explicit, granular consent. German competition law (UWG) adds further restrictions on unsolicited commercial communications.', optin:'Double opt-in', penalty:'Up to \u20AC20M / 4% rev' },
  { name:'Brazil', flag:'\u{1F1E7}\u{1F1F7}', lat:-14.2, lon:-51.9, regulation:'LGPD', desc:"Brazil's General Data Protection Law requires clear legal basis for processing personal data including phone numbers. Consent must be free, informed, and unambiguous.", optin:'Express consent', penalty:'Up to 2% of revenue' },
  { name:'Singapore', flag:'\u{1F1F8}\u{1F1EC}', lat:1.35, lon:103.8, regulation:'PDPA + DNC', desc:'The Personal Data Protection Act combined with the Do Not Call Registry requires businesses to check the DNC registry before sending marketing messages.', optin:'Clear & informed', penalty:'Up to S$1M' }
];

const pillsContainer = document.getElementById('country-pills');
countries.forEach((c, i) => {
  const pill = document.createElement('div');
  pill.className = 'country-pill';
  pill.innerHTML = '<span class="country-pill-flag">'+c.flag+'</span>'+c.name;
  pill.onclick = () => focusCountry(i);
  pillsContainer.appendChild(pill);
});

const container = document.getElementById('globe-container');
const w = container.clientWidth;
const h = container.clientHeight;

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(45, w/h, 0.1, 1000);
camera.position.z = 3.2;

const renderer = new THREE.WebGLRenderer({ antialias:true, alpha:true });
renderer.setSize(w, h);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setClearColor(0x000000, 0);
container.appendChild(renderer.domElement);

// Globe: soft pastel green to match their background
const globeGeo = new THREE.SphereGeometry(1, 64, 64);
const globeMat = new THREE.MeshPhongMaterial({
  color: 0xc8e6df,
  emissive: 0xa8d0c4,
  emissiveIntensity: 0.12,
  specular: 0xffffff,
  shininess: 18,
  transparent: true,
  opacity: 0.95
});
const globe = new THREE.Mesh(globeGeo, globeMat);
scene.add(globe);

// Wireframe in dark green
const wireGeo = new THREE.SphereGeometry(1.003, 36, 18);
const wireMat = new THREE.MeshBasicMaterial({ color:0x1a3c2a, wireframe:true, transparent:true, opacity:0.06 });
scene.add(new THREE.Mesh(wireGeo, wireMat));
const wireRef = scene.children[scene.children.length - 1];

// Atmosphere: soft teal glow
const atmosGeo = new THREE.SphereGeometry(1.06, 64, 64);
const atmosMat = new THREE.ShaderMaterial({
  vertexShader: 'varying vec3 vN;void main(){vN=normalize(normalMatrix*normal);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
  fragmentShader: 'varying vec3 vN;void main(){float i=pow(0.58-dot(vN,vec3(0,0,1)),2.5);gl_FragColor=vec4(0.36,0.75,0.68,1.0)*i*0.4;}',
  blending: THREE.AdditiveBlending,
  side: THREE.BackSide,
  transparent: true
});
scene.add(new THREE.Mesh(atmosGeo, atmosMat));

scene.add(new THREE.AmbientLight(0xffffff, 0.75));
const dl = new THREE.DirectionalLight(0xffffff, 0.55);
dl.position.set(5,3,5);
scene.add(dl);
const fl = new THREE.DirectionalLight(0xd4ebe4, 0.25);
fl.position.set(-3,-2,3);
scene.add(fl);

function latLonToVec3(lat, lon, r) {
  const phi = (90-lat)*(Math.PI/180);
  const theta = (lon+180)*(Math.PI/180);
  return new THREE.Vector3(-(r*Math.sin(phi)*Math.cos(theta)), r*Math.cos(phi), r*Math.sin(phi)*Math.sin(theta));
}

const markers = [];
const markerGroup = new THREE.Group();
scene.add(markerGroup);

countries.forEach((c, i) => {
  const pos = latLonToVec3(c.lat, c.lon, 1.012);
  const origin = new THREE.Vector3(0,0,0);

  const ringGeo = new THREE.RingGeometry(0.025, 0.04, 24);
  const ringMat = new THREE.MeshBasicMaterial({ color:0xe8734a, transparent:true, opacity:0.85, side:THREE.DoubleSide });
  const ring = new THREE.Mesh(ringGeo, ringMat);
  ring.position.copy(pos); ring.lookAt(origin);

  const dotGeo = new THREE.CircleGeometry(0.018, 16);
  const dotMat = new THREE.MeshBasicMaterial({ color:0xe8734a, transparent:true, opacity:1, side:THREE.DoubleSide });
  const dot = new THREE.Mesh(dotGeo, dotMat);
  dot.position.copy(pos); dot.lookAt(origin);

  const pulseGeo = new THREE.RingGeometry(0.04, 0.047, 24);
  const pulseMat = new THREE.MeshBasicMaterial({ color:0xe8734a, transparent:true, opacity:0.5, side:THREE.DoubleSide });
  const pulse = new THREE.Mesh(pulseGeo, pulseMat);
  pulse.position.copy(pos); pulse.lookAt(origin);

  markerGroup.add(ring); markerGroup.add(dot); markerGroup.add(pulse);
  markers.push({ ring, dot, pulse, data:c, index:i, pos });
});

const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();
let isDragging = false, prevMouse = {x:0,y:0}, rotVel = {x:0,y:0};
let autoRotate = true, targetRot = null, activeMarker = -1;

container.addEventListener('mousedown', e => { isDragging=true; autoRotate=false; prevMouse={x:e.clientX,y:e.clientY}; });
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  const dx=e.clientX-prevMouse.x, dy=e.clientY-prevMouse.y;
  rotVel.x=dy*0.003; rotVel.y=dx*0.003;
  globe.rotation.x+=rotVel.x; globe.rotation.y+=rotVel.y;
  wireRef.rotation.copy(globe.rotation); markerGroup.rotation.copy(globe.rotation);
  prevMouse={x:e.clientX,y:e.clientY};
});
window.addEventListener('mouseup', () => { isDragging=false; setTimeout(()=>{autoRotate=true;},3000); });

container.addEventListener('click', e => {
  const rect = container.getBoundingClientRect();
  mouse.x = ((e.clientX-rect.left)/rect.width)*2-1;
  mouse.y = -((e.clientY-rect.top)/rect.height)*2+1;
  raycaster.setFromCamera(mouse, camera);
  const hits = raycaster.intersectObjects(markers.flatMap(m=>[m.ring,m.dot,m.pulse]));
  if (hits.length>0) {
    const hit = hits[0].object;
    const mk = markers.find(m=>m.ring===hit||m.dot===hit||m.pulse===hit);
    if (mk) showTooltip(mk);
  }
});

function showTooltip(mk) {
  const c = mk.data;
  activeMarker = mk.index;
  document.getElementById('tt-flag').textContent = c.flag;
  document.getElementById('tt-country').textContent = c.name;
  document.getElementById('tt-reg').textContent = c.regulation;
  document.getElementById('tt-desc').textContent = c.desc;
  document.getElementById('tt-optin').textContent = c.optin;
  document.getElementById('tt-penalty').textContent = c.penalty;

  const tt = document.getElementById('tooltip');
  const area = document.querySelector('.globe-area');
  const ar = area.getBoundingClientRect();
  const p = mk.pos.clone();
  p.applyMatrix4(markerGroup.matrixWorld);
  p.project(camera);

  let sx = (p.x*0.5+0.5)*ar.width;
  let sy = (-p.y*0.5+0.5)*ar.height;
  let tx = sx+30, ty = sy-80;
  if (tx+340>ar.width) tx=sx-360;
  if (ty<0) ty=20;
  if (ty+340>ar.height) ty=ar.height-360;

  tt.style.left = tx+'px';
  tt.style.top = ty+'px';
  tt.classList.add('active');
  document.querySelectorAll('.country-pill').forEach((p,i)=>p.classList.toggle('active',i===mk.index));
}

function hideTooltip() {
  document.getElementById('tooltip').classList.remove('active');
  activeMarker=-1;
  document.querySelectorAll('.country-pill').forEach(p=>p.classList.remove('active'));
}

function focusCountry(idx) {
  const mk = markers[idx];
  const c = mk.data;
  targetRot = { x: -c.lat*(Math.PI/180)*0.3, y: -c.lon*(Math.PI/180)-Math.PI };
  autoRotate = false;
  setTimeout(()=>showTooltip(mk), 600);
  setTimeout(()=>{autoRotate=true;}, 5000);
}

let time = 0;
function animate() {
  requestAnimationFrame(animate);
  time += 0.016;

  if (autoRotate && !targetRot) {
    globe.rotation.y += 0.002;
    wireRef.rotation.copy(globe.rotation);
    markerGroup.rotation.copy(globe.rotation);
  }

  if (targetRot) {
    globe.rotation.x += (targetRot.x-globe.rotation.x)*0.05;
    globe.rotation.y += (targetRot.y-globe.rotation.y)*0.05;
    wireRef.rotation.copy(globe.rotation);
    markerGroup.rotation.copy(globe.rotation);
    if (Math.abs(targetRot.y-globe.rotation.y)<0.01) targetRot=null;
  }

  if (!isDragging && !targetRot) {
    rotVel.x*=0.95; rotVel.y*=0.95;
    if (!autoRotate) {
      globe.rotation.x+=rotVel.x; globe.rotation.y+=rotVel.y;
      wireRef.rotation.copy(globe.rotation); markerGroup.rotation.copy(globe.rotation);
    }
  }

  markers.forEach((m,i) => {
    const s = 1+Math.sin(time*2+i*0.8)*0.3;
    m.pulse.scale.set(s,s,s);
    m.pulse.material.opacity = 0.5-(s-1)*1;
    m.dot.material.color.setHex(i===activeMarker ? 0x1a3c2a : 0xe8734a);
    m.ring.material.opacity = i===activeMarker ? 1 : 0.85;
  });

  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
  const w=container.clientWidth, h=container.clientHeight;
  camera.aspect=w/h; camera.updateProjectionMatrix();
  renderer.setSize(w,h);
});
</script>
